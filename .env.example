# Copy this file to .env.local (Vite loads .env.local automatically and it's gitignored)
# and fill in real values from your Supabase project's Settings → API page.
# Leaving these unset is a supported, first-class state: the app runs fully in its
# local-JSON-only mode (Phases 0-4), and every auth-gated page shows a clear
# "Persistence is not configured" panel instead of crashing or silently faking data.

# --- Browser client (src/lib/supabaseClient.ts) ---
# The project URL and anon (public) key. Safe to expose to the browser — RLS
# (supabase/migrations/0002_rls.sql) is what actually protects private/restricted data,
# not secrecy of this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Seed script only (supabase/seed/seed.ts) ---
# NEVER prefix these with VITE_ — that would bundle the service-role key into the client
# JS and defeat RLS entirely. These are read only by the Node seed script via
# `npx tsx supabase/seed/seed.ts`, never by the browser build.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cross-link to the separate "Action Stakeholder Intelligence" app (src/lib/stakeholderCrosswalk.ts) ---
# That app is a different repo/deployment, not part of this one. Leaving this unset is the
# default and fully supported state: any drawer section that would link out to it (see
# src/data/stakeholderTechCrosswalk.json) instead renders the domain name as plain text with a
# note that the link isn't configured. Fill this in once that app has a real deployment URL —
# no trailing slash, e.g. https://action-stakeholder-intelligence.example.com
VITE_STAKEHOLDER_APP_URL=
